# =============================================================================
# Nasty Sport Fishing — env template
# =============================================================================
# Copy to `.env.local` for local dev. Generate secrets: openssl rand -hex 32
# =============================================================================

# --- Site ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase Admin (prefer path mode) ---
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./nasty-sport-fishing-service-account.json
# FIREBASE_STORAGE_BUCKET=your-nsf-project-id.appspot.com
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_PATH=

# --- Firebase Client (admin login) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
ADMIN_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@nastysportfishing.com
BREVO_SENDER_NAME=Nasty Sport Fishing
BREVO_BOOKING_TEMPLATE_ID=
BREVO_MARKETING_LIST_ID=
CONTACT_EMAIL=info@nastysportfishing.com
STAFF_OPERATIONS_EMAIL=

# --- Twilio (optional) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Upstash Redis (required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Secrets (each unique) ---
MANAGE_BOOKING_SECRET=
RELEASE_TOKEN_SECRET=
RECEIPT_TOKEN_SECRET=
ADMIN_EDGE_SECRET=
CRON_SECRET=
SEED_SECRET=
BLOCK_SECRET=
RELEASE_HOLD_INTERNAL_SECRET=
# HEALTH_INTERNAL_SECRET=
# BOOKING_CALENDAR_FEED_SECRET=

# --- Analytics ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GA_DEBUG=1
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_SEND_TO=
# NEXT_PUBLIC_GOOGLE_ADS_ID=

# --- Production only (Netlify) ---
# DISABLE_LEGACY_BOOKING_FALLBACK=true
# DISABLE_LEGACY_HOLDS_FALLBACK=true

# --- Optional ---
# PDFSHIFT_API_KEY=
# WARM_EXPERIENCE_ID=
# NEXT_PUBLIC_BOOKING_DEBUG=1
# SEED_OPEN_DEV=1
