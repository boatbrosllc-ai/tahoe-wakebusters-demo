# Firebase (Firestore) — use ONE of these:
# Option A (recommended): path to service account JSON (avoids .env key encoding issues).
#   In path mode, FIREBASE_PROJECT_ID and FIREBASE_CLIENT_EMAIL are NOT required; the file provides credentials.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=# Path to your service account JSON file (e.g. ./service-account.json)
# Option B: individual env vars (put key on one line with \n for newlines, or use FIREBASE_PRIVATE_KEY_PATH)
#   Required in variable mode: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and one of FIREBASE_PRIVATE_KEY or FIREBASE_PRIVATE_KEY_PATH
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Firebase Storage (for photo uploads). If uploads fail with "bucket does not exist", enable Storage in
# Firebase Console (Build → Storage → Get started), then set this to your bucket name if needed:
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# or for newer projects: your-project-id.firebasestorage.app

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for embedded checkout (required for booking/checkout). Set in host env so payment step is available.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio (optional SMS for confirmations, reminders, cancellation). When all three are set, SMS is sent alongside email.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=# E.164 e.g. +15551234567

# Brevo (transactional email + optional marketing list)
BREVO_API_KEY=
# Sender must be verified in Brevo (Senders & IP → Senders). Default: noreply@boatbrosatx.com
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_BOOKING_TEMPLATE_ID=
BREVO_MARKETING_LIST_ID=
# Contact form: where to receive submissions (default: boatbrosllc@gmail.com)
CONTACT_EMAIL=# Email address to receive contact form submissions

# App
APP_BASE_URL=http://localhost:3000
# Production: set to your live site URL (e.g. https://boatbrosatx.com) so the book-now calendar and booking APIs hit the correct origin.
# NEXT_PUBLIC_SITE_URL=https://boatbrosatx.com
# Optional: set to 1 to show booking debug logs in the browser console (slots fetch, month nav, date selection)
# NEXT_PUBLIC_BOOKING_DEBUG=1
# Server-side: set to verbose to enable bookingLog/bookingWarn in production. Increases log verbosity and PCI-DSS scope.
# BOOKING_LOG_LEVEL=verbose
# Google Analytics (optional). Measurement ID from GA4 → Admin → Data streams (boatbrosatx.com web stream).
# Set in Netlify so production sends data to the boatbrosatx.com stream.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1QM1E4C1BB

# Legacy booking/holds fallback (production): when unset, capped legacy scans run on slot/availability/date-prices.
# After running /api/admin/backfill-start-date-str until missingCount is 0 for bookings and holds, set both in Netlify:
# DISABLE_LEGACY_BOOKING_FALLBACK=true
# DISABLE_LEGACY_HOLDS_FALLBACK=true

# Blocks overlap query needs a Firestore composite index (see firestore.indexes.json → blocks). Deploy: firebase deploy --only firestore:indexes
# Development: block check fails open automatically if the index is missing (so create-hold works locally). Set ENABLE_BLOCK_CHECK_FAIL_OPEN=false to enforce blocks in dev.
# Production/staging: do not rely on fail-open — deploy indexes. UNSAFE: ENABLE_BLOCK_CHECK_FAIL_OPEN=true skips block enforcement when the query fails.
# ENABLE_BLOCK_CHECK_FAIL_OPEN=

# --- Production-required: rate limiting (Upstash Redis) ---
# Without these in NODE_ENV=production, booking APIs return 503. Use UPSTASH_* or RATE_LIMIT_* (same values).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative names (optional if UPSTASH_* set):
# RATE_LIMIT_REDIS_REST_URL=
# RATE_LIMIT_REDIS_REST_TOKEN=
# When Redis is configured but unreachable: default fail-open for most endpoints; set RATE_LIMIT_FAIL_CLOSED=1 to return 503.
# RATE_LIMIT_FAIL_CLOSED=1
# validate-discount fails closed on Redis errors by default; set to 1 to allow fail-open there when Redis is down.
# RATE_LIMIT_VALIDATE_DISCOUNT_DEGRADED_FAIL_OPEN=1
# RATE_LIMIT_DEGRADED_USE_MEMORY=1

# --- Cryptographic secrets (use independent random values; do not reuse across variables) ---
# 50/50 manage-booking links: HMAC for tokens shown in /booking/manage?token=...
MANAGE_BOOKING_SECRET=
# Receipt + receipt-claim tokens (success page / email). Prefer dedicated secret; falls back to MANAGE_BOOKING_SECRET only during migration.
RECEIPT_TOKEN_SECRET=
# REQUIRED FOR BACK NAVIGATION AND SLOT RELEASE TO WORK (set in local dev too, not only production).
# Signs release_token from create-hold for /api/booking/release-hold and cancel URLs.
# If omitted, customers cannot release holds when closing the modal or using back (slots stay locked up to the hold TTL).
RELEASE_TOKEN_SECRET=
# Admin Edge session cookie (middleware). Must be at least 32 UTF-8 bytes (e.g. openssl rand -hex 32).
ADMIN_EDGE_SECRET=

# Cron: scheduled functions call /api/admin/cron/* with Authorization: Bearer CRON_SECRET
CRON_SECRET=
# Seed endpoints (boats, experiences): never use for release-hold or calendar admin; use SEED_SECRET only for seed APIs.
SEED_SECRET=
# Calendar block/unblock APIs (block-slot, unblock-slot, block-date): internal Bearer auth. Must be separate from SEED_SECRET; do not distribute to developer machines used only for seeding.
BLOCK_SECRET=

# Health endpoint: when set, send header X-Internal-Health-Secret with this value to get full diagnostic response (otherwise only status is returned).
# HEALTH_INTERNAL_SECRET=
# Optional: set to 1 only in local development to allow unauthenticated seed (no SEED_SECRET required). Ignored when VERCEL or NETLIFY is set.
# SEED_OPEN_DEV=1

# Optional: iCal feed. GET /api/booking/calendar.ics?token=SECRET&experienceId=...&from=YYYY-MM-DD&to=YYYY-MM-DD
# BOOKING_CALENDAR_FEED_SECRET=
# Legacy alias:
# CALENDAR_FEED_SECRET=

# Admin sign-in (Firebase Auth email/password). If unset, admin routes stay open (dev only).
ADMIN_EMAIL=
# Firebase client config for login page (from Firebase Console → Project settings → Your apps → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=# Web API key from Firebase Console → Project settings → Your apps → Web app
FIREBASE_PRIVATE_KEY=# Full PEM private key on one line with \n for newlines (from service account JSON)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
