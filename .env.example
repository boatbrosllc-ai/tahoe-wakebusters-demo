# =============================================================================
# Slipstack Platform — env template
# Copy to `.env.local` for local dev. Generate secrets: openssl rand -hex 32
# Never commit real credentials.
#
# One repo clone = one customer. Identity lives in config/site.ts (not env).
# Firebase / Stripe / domain belong to this deployment's env vars.
# =============================================================================

# --- Public / browser (safe to expose; inlined into the client bundle) ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_DEBUG=1
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_SEND_TO=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_SHOW_PLATFORM_BANNER=1

# --- Private / server-only ---
# Firebase Admin (prefer path mode)
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=

ADMIN_EMAIL=
# PLATFORM_ADMIN_EMAIL=

STRIPE_SECRET_KEY=
# STRIPE_CONNECT_SECRET_KEY=
# STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=
# BREVO_BOOKING_TEMPLATE_ID=
# BREVO_MARKETING_LIST_ID=
CONTACT_EMAIL=
STAFF_OPERATIONS_EMAIL=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# STAFF_SMS_PHONE=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MANAGE_BOOKING_SECRET=
RELEASE_TOKEN_SECRET=
RECEIPT_TOKEN_SECRET=
ADMIN_EDGE_SECRET=
ADMIN_COOKIE_SECRET=
CRON_SECRET=
SEED_SECRET=
BLOCK_SECRET=
RELEASE_HOLD_INTERNAL_SECRET=

# --- Marketplace Sync (Gmail) — Full plan ---
# OAuth app can be Slipstack's Google Cloud client; each customer connects their ops inbox.
# Template/demo expected inbox:
GMAIL_ACCOUNT_EMAIL=team@slipstack.io
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_TOKEN_ENCRYPTION_KEY=
# GMAIL_OAUTH_STATE_SECRET=
# GMAIL_PUBSUB_PUSH_TOKEN=
# GMAIL_WATCH_TOPIC=projects/YOUR_GCP_PROJECT/topics/gmail-marketplace-notifications
# GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-pubsub-push@YOUR_GCP_PROJECT.iam.gserviceaccount.com
# GMAIL_PUBSUB_SKIP_OIDC=1
# GMAIL_REFRESH_TOKEN=

# Optional Super Admin display name (Team UI)
# ADMIN_DISPLAY_NAME=

# --- Org provisioning (server-only; never NEXT_PUBLIC_*) ---
# HEALTH_INTERNAL_SECRET=
# BOOKING_CALENDAR_FEED_SECRET=
# GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# --- Org provisioning (server-only; never NEXT_PUBLIC_*) ---
# PROVISIONING_WORKER_URL=https://slipstack-provisioner-HASH-uc.a.run.app
# PROVISIONING_WORKER_SECRET=

# --- Production gates (Netlify) ---
# DISABLE_LEGACY_BOOKING_FALLBACK=true
# DISABLE_LEGACY_HOLDS_FALLBACK=true
# SLIPSTACK_CUSTOMER_CONFIG_REQUIRED=1

# --- Optional ---
# PDFSHIFT_API_KEY=
# WARM_EXPERIENCE_ID=
# BOOKING_LOG_LEVEL=verbose
# SEED_OPEN_DEV=1
# ENABLE_SEED_ENDPOINT=true
# Required whenever ENABLE_SEED_ENDPOINT is used (API seed overwrites catalog/rates):
# SEED_CONFIRM_PHRASE=
# Optional alias for applying admin backfills (falls back to SEED_CONFIRM_PHRASE):
# BACKFILL_CONFIRM_PHRASE=
# Emergency only — re-enables deprecated Stripe Checkout Session API:
# ENABLE_LEGACY_CHECKOUT_SESSION=true
