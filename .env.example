# Firebase (Firestore) — use ONE of these:
# Option A (recommended): path to service account JSON (avoids .env key encoding issues).
#   In path mode, FIREBASE_PROJECT_ID and FIREBASE_CLIENT_EMAIL are NOT required; the file provides credentials.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=# Path to your service account JSON file (e.g. ./service-account.json)
# Option B: individual env vars (put key on one line with \n for newlines, or use FIREBASE_PRIVATE_KEY_PATH)
#   Required in variable mode: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and one of FIREBASE_PRIVATE_KEY or FIREBASE_PRIVATE_KEY_PATH
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Firebase Storage (for photo uploads). If uploads fail with "bucket does not exist", enable Storage in
# Firebase Console (Build → Storage → Get started), then set this to your bucket name if needed:
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# or for newer projects: your-project-id.firebasestorage.app

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key for embedded checkout (required for booking/checkout). Set in host env so payment step is available.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio (optional SMS for confirmations, reminders, cancellation). When all three are set, SMS is sent alongside email.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=# E.164 e.g. +15551234567

# Brevo (transactional email + optional marketing list)
BREVO_API_KEY=
# Sender must be verified in Brevo (Senders & IP → Senders). Default: noreply@boatbrosatx.com
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_BOOKING_TEMPLATE_ID=
BREVO_MARKETING_LIST_ID=
# Contact form: where to receive submissions (default: boatbrosllc@gmail.com)
CONTACT_EMAIL=# Email address to receive contact form submissions
# Staff/captain inbox for internal booking alerts (required in production; see SECURITY.md)
STAFF_OPERATIONS_EMAIL=

# App
APP_BASE_URL=http://localhost:3000
# Production: must be https://your-domain (absolute). Used for waiver links, manage links, and emails.
# Waiver PDF in serverless (Netlify): HTML-to-PDF API (omit for local Playwright fallback if playwright is installed).
# PDFSHIFT_API_KEY=
# Netlify scheduled `warm-booking`: Firestore experience document id for pontoon (or primary listing) — warms slots, experience-detail, date-prices.
# WARM_EXPERIENCE_ID=
# Production: set to your live site URL (e.g. https://boatbrosatx.com) so the book-now calendar and booking APIs hit the correct origin.
# NEXT_PUBLIC_SITE_URL=https://boatbrosatx.com
# Optional: set to 1 to show booking debug logs in the browser console (slots fetch, month nav, date selection)
# NEXT_PUBLIC_BOOKING_DEBUG=1
# Server-side: set to verbose to enable bookingLog/bookingWarn in production. Increases log verbosity and PCI-DSS scope.
# BOOKING_LOG_LEVEL=verbose
# Google Analytics (GA4): Measurement ID from GA4 → Admin → Data streams.
# Production (NODE_ENV=production / Netlify production): REQUIRED — set to your active web stream `G-XXXXXXXXXX`.
#   There is no built-in fallback ID in production; deploy checks and `/api/health` expect GA to be enabled intentionally.
# Local dev: optional — when unset, a dev fallback ID is used so Realtime/DebugView works without extra config.
# Set to a valid `G-XXXXXXXXXX` to pick a specific stream; set to `off` (or `0`) to disable GA locally.
# Netlify: set `NEXT_PUBLIC_GA_MEASUREMENT_ID` on the site (production context).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1QM1E4C1BB
# NEXT_PUBLIC_GA_MEASUREMENT_ID=off

# --- First production deploy (required): legacy Firestore fallbacks ---
# Until BOTH are true, booking APIs return 503 in production unless the database has zero bookings and zero holds (greenfield probe at startup).
# After backfill: run /api/admin/backfill-start-date-str until missingCount is 0, then set both in your host (e.g. Netlify):
# DISABLE_LEGACY_BOOKING_FALLBACK=true
# DISABLE_LEGACY_HOLDS_FALLBACK=true

# Blocks overlap query needs a Firestore composite index (see firestore.indexes.json → blocks). Deploy: firebase deploy --only firestore:indexes
# If the blocks index is missing or still building, create-hold and related APIs return 503 until the index is READY (no fail-open).
#
# ENABLE_BLOCK_CHECK_FAIL_OPEN is obsolete (ignored by code). Do not set ENABLE_BLOCK_CHECK_FAIL_OPEN=true anywhere: production startup fails if it is set.
# Production/staging: deploy firestore.indexes.json and confirm blocks composites are Enabled in Firebase Console before traffic.
# ENABLE_BLOCK_CHECK_FAIL_OPEN=

# --- Production-required: rate limiting (Upstash Redis) ---
# Without these in NODE_ENV=production, booking APIs return 503. Use UPSTASH_* or RATE_LIMIT_* (same values).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative names (optional if UPSTASH_* set):
# RATE_LIMIT_REDIS_REST_URL=
# RATE_LIMIT_REDIS_REST_TOKEN=
# When Redis is configured but unreachable: in production, in-memory degraded limiting is ON by default (set RATE_LIMIT_DEGRADED_USE_MEMORY=0 to disable).
# Set RATE_LIMIT_FAIL_CLOSED=1 to return 503 for most endpoints when Redis is down.
# RATE_LIMIT_FAIL_CLOSED=1
# create-hold / create-payment-intent: fail closed on Redis errors when set (defense in depth with degraded memory).
# RATE_LIMIT_MUTATION_FAIL_CLOSED=1
# validate-discount fails closed on Redis errors by default; set to 1 to allow fail-open there when Redis is down.
# RATE_LIMIT_VALIDATE_DISCOUNT_DEGRADED_FAIL_OPEN=1
# RATE_LIMIT_DEGRADED_USE_MEMORY=0

# --- Cryptographic secrets (use independent random values; do not reuse across variables) ---
# 50/50 manage-booking links: HMAC for tokens shown in /booking/manage?token=...
MANAGE_BOOKING_SECRET=
# Optional: signed receipt URLs (booking success, email links, calendar.ics). If unset, payments still work;
# confirmation uses Stripe PaymentIntent metadata + holdId from the client session, and receipt API can use payment_intent_id.
# When set, MUST differ from MANAGE_BOOKING_SECRET (health check in production).
RECEIPT_TOKEN_SECRET=
# **Required in staging/production:** signs `release_token` from create-hold for POST /api/booking/release-hold and cancel URLs.
# Without this secret, create-hold cannot issue a token — customers who cancel checkout cannot release the slot early;
# the slot stays unavailable until the hold expires (see HOLD_EXPIRY_MINUTES in lib/booking/constants.ts).
# Set in local dev too if you test cancel/back flows.
RELEASE_TOKEN_SECRET=
# Admin Edge session cookie (middleware). Must be at least 32 UTF-8 bytes (e.g. openssl rand -hex 32).
ADMIN_EDGE_SECRET=

# Cron: scheduled functions call /api/admin/cron/* with Authorization: Bearer CRON_SECRET and X-Cron-Timestamp (Unix seconds, ±5 min).
CRON_SECRET=
# Server action / dashboard: optional extra key for seed flows that are not HTTP (see admin dashboard).
SEED_SECRET=
# Calendar block/unblock APIs (block-slot, unblock-slot, block-date): internal Bearer auth. Must be separate from SEED_SECRET.
BLOCK_SECRET=
# Release-hold without release_token: Bearer auth for trusted automation (not BLOCK_SECRET — separate blast radius).
RELEASE_HOLD_INTERNAL_SECRET=

# Health endpoint: when set, send header X-Internal-Health-Secret with this value to get full diagnostic response (otherwise only status is returned).
# HEALTH_INTERNAL_SECRET=
# Optional: set to 1 only in local development to allow unauthenticated seed (no SEED_SECRET required). Ignored when VERCEL or NETLIFY is set.
# SEED_OPEN_DEV=1

# Optional: iCal bulk feed (sensitive — rotate if exposed). GET /api/booking/calendar.ics?token=SECRET&experienceId=...&from=YYYY-MM-DD&to=YYYY-MM-DD
# BOOKING_CALENDAR_FEED_SECRET=
# Legacy alias:
# CALENDAR_FEED_SECRET=

# Default max TTL (days) for manage-booking links from signManageToken when exp is omitted (email/cron links). Default 3.
# MANAGE_BOOKING_LINK_TTL_DAYS=3

# Admin sign-in (Firebase Auth email/password). If unset, admin routes stay open (dev only).
ADMIN_EMAIL=
# Firebase client config for login page (from Firebase Console → Project settings → Your apps → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=# Web API key from Firebase Console → Project settings → Your apps → Web app
FIREBASE_PRIVATE_KEY=# Full PEM private key on one line with \n for newlines (from service account JSON)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
