# =============================================================================
# Slipstack Platform — env template
# Copy to `.env.local` for local dev. Generate secrets: openssl rand -hex 32
# Never commit real credentials.
#
# This checkout selects a customer frontend via SLIPSTACK_SITE_ID (see sites/README.md).
# Firebase project IDs belong here — never hardcode a customer database in source.
# =============================================================================

# --- Public / browser (safe to expose; inlined into the client bundle) ---
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Customer site: platform-dev | abc-boats  (restart Next.js after changing)
SLIPSTACK_SITE_ID=abc-boats
# SITE_ID=abc-boats
# NEXT_PUBLIC_SLIPSTACK_SITE_ID=abc-boats
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_DEBUG=1
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_SEND_TO=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_SHOW_PLATFORM_BANNER=1

# --- Private / server-only ---
# Firebase Admin (prefer path mode)
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=

ADMIN_EMAIL=
# PLATFORM_ADMIN_EMAIL=

STRIPE_SECRET_KEY=
# STRIPE_CONNECT_SECRET_KEY=
# STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_BOOKING_TEMPLATE_ID=
BREVO_MARKETING_LIST_ID=
CONTACT_EMAIL=
STAFF_OPERATIONS_EMAIL=

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# STAFF_SMS_PHONE=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MANAGE_BOOKING_SECRET=
RELEASE_TOKEN_SECRET=
RECEIPT_TOKEN_SECRET=
ADMIN_EDGE_SECRET=
ADMIN_COOKIE_SECRET=
CRON_SECRET=
SEED_SECRET=
BLOCK_SECRET=
RELEASE_HOLD_INTERNAL_SECRET=
# HEALTH_INTERNAL_SECRET=
# BOOKING_CALENDAR_FEED_SECRET=
# GA4_MEASUREMENT_PROTOCOL_API_SECRET=

# --- Org provisioning (server-only; never NEXT_PUBLIC_*) ---
# Netlify cannot mint a Google-verifiable OIDC token. Production auth is:
#   Netlify control plane --HMAC--> Cloud Run worker --ADC--> slipstack-provisioner
# Do not set GOOGLE_PROVISIONING_SERVICE_ACCOUNT_JSON or _B64 (blocked in production).
# PROVISIONING_WORKER_URL=https://slipstack-provisioner-HASH-uc.a.run.app
# PROVISIONING_WORKER_SECRET=
# Cloud Run worker only (set on the service, not on Netlify):
# PROVISIONING_RUNTIME=cloudrun
# GOOGLE_CLOUD_PROJECT=slipstack-org-setup
# GOOGLE_PROVISIONING_SERVICE_ACCOUNT_EMAIL=slipstack-provisioner@slipstack-org-setup.iam.gserviceaccount.com
# Optional local: gcloud auth application-default login
# GOOGLE_PROVISIONING_IMPERSONATE_SA=slipstack-provisioner@slipstack-org-setup.iam.gserviceaccount.com
# PROVISIONING_USE_MOCK=1
# ALLOW_DEPRECATED_PROVISIONING_SA_JSON=1

# --- Production gates (Netlify) ---
# DISABLE_LEGACY_BOOKING_FALLBACK=true
# DISABLE_LEGACY_HOLDS_FALLBACK=true

# --- Optional ---
# PDFSHIFT_API_KEY=
# WARM_EXPERIENCE_ID=
# BOOKING_LOG_LEVEL=verbose
# SEED_OPEN_DEV=1
# ENABLE_SEED_ENDPOINT=true
# SEED_CONFIRM_PHRASE=
